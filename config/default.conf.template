server {
    listen ${NGINX_PORT};
    server_name _;
    root /srv/coming-soon;
    charset utf-8;
    add_header Cache-Control "no-cache" always;
    add_header X-Robots-Tag "noindex" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /index.html {
        sub_filter 'PAGE_TITLE' '${ESCAPED_TITLE}';
    }

    # Keep bookmarked page URLs useful without disguising missing assets as HTML.
    location ~ /[^/]+\.[^/]+$ {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
